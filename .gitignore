# macOS
.DS_Store

# Herdr runtime state: only config.toml is tracked.
herdr/.config/herdr/*.log
herdr/.config/herdr/session.json
herdr/.config/herdr/.plugins.lock

# Rime dictionary backups: only encrypted snapshots are tracked.
rime-data/*.txt
rime-data/*.key
rime-data/*.identity
rime-data/.tmp-*
!rime-data/age-recipient.txt
!rime-data/squirrel-commit.txt
