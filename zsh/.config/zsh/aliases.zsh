alias shcfg="nvim ~/.zshrc"          # machine-local
alias dotcfg="nvim ~/.config/zsh"    # tracked
alias sshcfg="source ~/.zshrc"

alias galias="alias | grep 'git' | grep"
alias gg="git status --short --branch"

alias n="nvim"
alias t="tmux"
alias lg="lazygit"
alias lf="yazi"

export LG_CONFIG_FILE="$HOME/.config/lazygit/config.yml,$HOME/.config/lazygit/theme.yml"
