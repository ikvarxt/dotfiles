diff --git a/scripts/postinstall b/scripts/postinstall
index 7ef6cb9..1dd8b6e 100755
--- a/scripts/postinstall
+++ b/scripts/postinstall
@@ -15,7 +15,16 @@ if [ -z "${RIME_NO_PREBUILD}" ]; then
     pushd "${rime_shared_data_path}" > /dev/null
     "${squirrel_executable}" --build
     popd > /dev/null
-fi && (
+fi
+
+# A locally built package is ad-hoc signed. Prebuilding shared data above adds
+# files inside the bundle, so refresh the signature before InputMethodKit
+# attempts to launch the input method.
+/usr/bin/codesign --force --deep --sign - \
+    --preserve-metadata=entitlements,requirements,flags \
+    "${squirrel_app_root}"
+
+(
     /usr/bin/sudo -u "${login_user}" "${squirrel_executable}" --enable-input-source
     /usr/bin/sudo -u "${login_user}" "${squirrel_executable}" --select-input-source
 )
